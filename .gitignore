# Ignore everything by default; re-include directories and files that have an extension
**/*
!**/
!**/*.*

# Compiled Java class files
*.class

# Compiled C files (object files; extensionless executables are caught by the blanket rule above)
*.o
*.obj
*.out

# Java packaging / archives
*.jar
*.war
*.ear
*.nar

# Build output directories
bin/
build/
out/
target/

# Log and crash files
*.log
hs_err_pid*
replay_pid*

# macOS
.DS_Store
